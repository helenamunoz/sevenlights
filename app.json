{
  "expo": {
    "name": "SevenLights",
    "slug": "SevenLights",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sevenlights",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0C14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.helena.sevenlights"
    },
    "android": {
      "package": "com.helena.sevenlights",
      "adaptiveIcon": {
        "backgroundColor": "#0E0C14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0C14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SevenLights uses your photos to build your vision boards.",
          "cameraPermission": "SevenLights uses the camera to add a photo to a board."
        }
      ],
      "expo-localization",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#9B6FD1"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "es": "./assets/locales/es.json"
    }
  }
}
