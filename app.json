{
  "expo": {
    "name": "SevenLights",
    "slug": "SevenLights",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sevenlights",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0E0C14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.helena.sevenlights"
    },
    "android": {
      "package": "com.helena.sevenlights",
      "adaptiveIcon": {
        "backgroundColor": "#0E0C14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0C14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SevenLights usa tus fotos para armar los tableros de cada centro.",
          "cameraPermission": "SevenLights usa la cámara para sumar una foto al tablero."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
