{
  "expo": {
    "name": "7Lights",
    "slug": "SevenLights",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sevenlights",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#191111",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.helena.sevenlights",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.helena.sevenlights",
      "adaptiveIcon": {
        "backgroundColor": "#321928",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#191111",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 84
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "7Lights uses your photos to build your vision boards.",
          "cameraPermission": "7Lights uses the camera to add a photo to a board."
        }
      ],
      "expo-localization",
      "expo-audio",
      [
        "expo-notifications",
        {
          "color": "#BE93BF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "es": "./assets/locales/es.json"
    },
    "owner": "tempo.software",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b197ecd-57a6-4757-9123-6eee428d2213"
      }
    },
    "runtimeVersion": "exposdk:57.0.0",
    "updates": {
      "url": "https://u.expo.dev/4b197ecd-57a6-4757-9123-6eee428d2213"
    }
  }
}
