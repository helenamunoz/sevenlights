# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Without these the app still runs; boards just stay on this device.
#
# Both values are public by design: the anon key only grants what the row level
# security policies in supabase/schema.sql allow. Never put the service_role key
# in this file — it bypasses every policy.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
