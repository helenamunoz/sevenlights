# Copy to .env.local and fill in from Supabase → Project Settings → API.
# The app needs both: every screen sits behind sign-in.
#
# Both values are public by design: the anon key only grants what the row level
# security policies in supabase/schema.sql allow. Never put the service_role key
# in this file — it bypasses every policy.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The app's Instagram profile, linked from the profile tab.
EXPO_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-profile
