# The app reads three public values that say where the backend is. After
# deploying it (see the README), `node scripts/write-env.mjs` fills them in
# from amplify_outputs.json; or copy them by hand.
#
# All three are public by design — they ship inside every copy of the app.
# What a signed-in person may do is decided by the backend, not by these.
# AWS access keys never belong in this file.

EXPO_PUBLIC_AWS_REGION=us-east-1
EXPO_PUBLIC_COGNITO_CLIENT_ID=your-user-pool-client-id
EXPO_PUBLIC_API_URL=https://your-api-id.appsync-api.us-east-1.amazonaws.com/graphql

# The app's Instagram profile, linked from the profile tab.
EXPO_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-profile
